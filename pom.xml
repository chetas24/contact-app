    <groupId>com.project1</groupId>
    <artifactId>contact-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>contact-app</name>
    <description>Parent project for contact services</description>

    <modules>
        <module>contact-save-service</module>
        <module>contact-fetch-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-boot.version>3.4.5</spring-boot.version>
    </properties>

</project>